<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_form_material_request_afasco" model="ir.ui.view">
        <field name="name">material.request.form.view</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <form string="Material Request">
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '0', 'fold_field': 'fold'}"
                           nolabel="1" readonly="1"/>
                    <button name="action_first_approve_request"
                            string="Approve"
                            type="object" class="oe_highlight" data-hotkey="o"
                            invisible="state != 'new'"
                            groups="landscape_construction.group_material_request_approver"/>
                    <button name="action_create_rfq" string="Create RFQ"
                            type="object" class="oe_highlight"
                            groups="purchase.group_purchase_user"
                            invisible="state != 'approved' or rfq_create == True"
                            data-hotkey="o"/>
                    <button name="action_reject_request" string="Reject"
                            type="object" class="oe_highlight" data-hotkey="o"
                            invisible="state != 'new'"
                            groups="landscape_construction.group_material_request_approver"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_project_material_request"
                                type="object"
                                class="oe_stat_button" icon="fa-building"
                                string="RFQ">
                            <div class="o_stat_info">
                                <span class="o_stat_text">RFQ</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h2>
                            <field name="sequence_code" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Material Request"
                              name="material_request_ids">
                            <field name="request_line_ids" widget="one2many">
                                <list string="Request Line" editable="bottom">
                                    <field name="material_item_id"
                                           column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                    <field name="project_id"
                                           column_invisible="1"/>
                                    <field name="item_id"
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="description"/>
                                    <field name="uom_id"/>
                                    <field name="quantity"/>
                                    <button name="action_view_on_hand"
                                            string="On Hand Quantity"
                                            type="object" class="oe_highlight"
                                            data-hotkey="o"/>
                                </list>
                            </field>
                        </page>
                        <page string="Other Information"
                              name="other_information">
                            <group>
                                <group>
                                    <group>
                                        <field name="approved_by"
                                               readonly="1"/>
                                        <field name="pm_approve_date"
                                               readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="rejected_by"
                                               readonly="1"/>
                                        <field name="rejected_date"
                                               readonly="1"/>
                                    </group>
                                </group>
                                <group>
                                </group>
                            </group>
                            <separator string="Requisition Reason"/>
                            <field name="requisition_reason"
                                   readonly="state != 'new'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_material_request_tree_afasco" model="ir.ui.view">
        <field name="name">material.request.list.view</field>
        <field name="model">material.request</field>
        <field name="arch" type="xml">
            <list string="Material Request" create="1" delete="1">
                <field name="sequence_code"/>
                <field name="project_id"/>
                <field name="vendor_id"/>
                <field name="user_id"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_material_request" model="ir.actions.act_window">
        <field name="name">Material Request</field>
        <field name="res_model">material.request</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_material_request_tree_afasco"/>
        <field name="context"></field>
        <field name="help" type="html">
            <p>
                Create and manage your Material Request
            </p>
        </field>
    </record>
    <menuitem
            name="Material Request"
            id="menu_material_request"
            groups="landscape_construction.group_material_request"
            active="True"
            web_icon="landscape_construction,static/description/mrp.png"
            sequence="8"
    >
        <menuitem
                name="Material Request"
                id="menu_material_request_main_root"
                action="action_material_request"
                sequence="5"
        />
    </menuitem>

</odoo>