<?xml version="1.0"?>
<odoo>
    <record id="view_company_inherit_mayoof_form" model="ir.ui.view">
        <field name="name">res.company.mayoof.form.inherit</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="model">res.company</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='social_media']" position="after">
                <group name="company_settings">
                    <field name="sales_profit"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>