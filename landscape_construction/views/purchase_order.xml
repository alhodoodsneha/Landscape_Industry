<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_inherit_afasco_prj" model="ir.ui.view">
        <field name="name">purchase.order.inherit.afasco.prj</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="project_purchase.view_order_form_inherit_project_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
               <field name="sales_order_id" />
               <field name="allowed_analytic_ids" invisible="1"/>
               <field name="purchase_analytic_id"/>
               <field name="material_id"/>
            </xpath>
        </field>
    </record>
</odoo>