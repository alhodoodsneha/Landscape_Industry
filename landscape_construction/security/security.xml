<?xml version="1.0" encoding="utf-8"?>
<odoo>

     <record model="ir.module.category" id="module_project_team_category">
        <field name="name">Project Team</field>
        <field name="sequence">95</field>
    </record>

     <!--    Inspection User Group-->
      <record model="res.groups.privilege" id="res_groups_privilege_inspection_category">
        <field name="name">Inspection</field>
        <field name="sequence">4</field>
        <field name="category_id" ref="module_project_team_category"/>
    </record>


    <record model="res.groups" id="group_inspection_user">
        <field name="name">Inspection User</field>
        <field name="comment">Can view their Inspection User.</field>
        <field name="privilege_id" ref="res_groups_privilege_inspection_category"/>
    </record>

    <record model="res.groups" id="group_inspection_manager">
        <field name="name">Inspection Manger</field>
        <field name="comment">Can view their Inspection Manger.</field>
        <field name="privilege_id" ref="res_groups_privilege_inspection_category"/>
        <field name="implied_ids" eval="[(4, ref('landscape_construction.group_inspection_user'))]"/>
    </record>

       <!--    Design User Group-->
     <record model="res.groups.privilege" id="res_groups_privilege_design_category">
        <field name="name">Design</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="module_project_team_category"/>
    </record>

    <record model="res.groups" id="group_design_user">
        <field name="name">Design User</field>
        <field name="comment">Can view their Design User.</field>
         <field name="privilege_id" ref="res_groups_privilege_design_category"/>
    </record>
    <record model="res.groups" id="group_design_manager">
        <field name="name">Design Manger</field>
        <field name="comment">Can view their Design Manger.</field>
        <field name="privilege_id" ref="res_groups_privilege_design_category"/>
        <field name="implied_ids" eval="[(4, ref('landscape_construction.group_design_user'))]"/>
    </record>

      <!--    Estimation User Group-->
      <record model="res.groups.privilege" id="res_groups_privilege_estimation_category">
        <field name="name">Estimation</field>
        <field name="sequence">6</field>
        <field name="category_id" ref="module_project_team_category"/>
    </record>
    <record model="res.groups" id="group_estimation_user">
        <field name="name">Estimation User</field>
        <field name="comment">Can view their Estimation User.</field>
        <field name="privilege_id" ref="res_groups_privilege_estimation_category"/>
    </record>
    <record model="res.groups" id="group_estimation_manager">
        <field name="name">Estimation Manger</field>
         <field name="comment">Can view their Estimation Manger.</field>
       <field name="privilege_id" ref="res_groups_privilege_estimation_category"/>
        <field name="implied_ids" eval="[(4, ref('landscape_construction.group_estimation_user'))]"/>
    </record>

         <!--    Project Manager User Group-->
       <record model="res.groups.privilege" id="res_groups_privilege_landscape_project_manager_category">
        <field name="name">Project</field>
        <field name="sequence">7</field>
        <field name="category_id" ref="module_project_team_category"/>
    </record>
    <record model="res.groups" id="group_landscape_project_team_manager">
        <field name="name">Project Manager</field>
        <field name="comment">Assign As A Project Manager While Create A Project.</field>
        <field name="privilege_id" ref="res_groups_privilege_landscape_project_manager_category"/>
    </record>

       <!--    Project Invoice Creation User Group-->
       <record model="res.groups.privilege" id="res_groups_privilege_landscape_invoice_creation_category">
        <field name="name">Project Invoice</field>
        <field name="sequence">8</field>
        <field name="category_id" ref="module_project_team_category"/>
    </record>
    <record model="res.groups" id="group_allow_create_invoice">
        <field name="name">Invoice Creator</field>
        <field name="comment">User Create Project Invoice.</field>
        <field name="privilege_id" ref="res_groups_privilege_landscape_invoice_creation_category"/>
    </record>

     <!--   Material Request User Group-->
    <record model="res.groups.privilege" id="res_groups_privilege_landscape_material_request">
        <field name="name">Material Request</field>
        <field name="sequence">9</field>
        <field name="category_id" ref="module_project_team_category"/>
    </record>

      <record model="res.groups" id="group_material_request">
          <field name="name">Material Request</field>
