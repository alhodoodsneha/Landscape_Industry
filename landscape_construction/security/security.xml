          <field name="privilege_id" ref="res_groups_privilege_material_request_approver"/>
    </record>

      <!--   Site Operation User Group-->
    <record model="res.groups.privilege" id="res_groups_privilege_landscape_site_operation">
        <field name="name">Site Operation</field>
        <field name="sequence">11</field>
        <field name="category_id" ref="module_project_team_category"/>
    </record>

      <record model="res.groups" id="group_site_operation">
          <field name="name">Site Operation view</field>
          <field name="comment">User View Site Operation.</field>
          <field name="privilege_id" ref="res_groups_privilege_landscape_site_operation"/>
    </record>

</odoo>