          <field name="privilege_id" ref="res_groups_privilege_landscape_material_request"/>
    </record>

     <record model="res.groups.privilege" id="res_groups_privilege_material_request_approver">
        <field name="name">Material Request Approver</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_project_team_category"/>
